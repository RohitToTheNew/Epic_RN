{
  "name": "EpicMobileApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "pods": "cd ios && pod install && cd ..",
    "xcode": "xed -b ios",
    "clean": "cd android && ./gradlew clean",
    "open": "open android/app/build/outputs/apk/release/",
    "tcp": "adb reverse tcp:8081 tcp:8081",
    "build": "cd android && ./gradlew assembleRelease",
    "env:prod": "node ./src/config/scripts/set-environment.js production",
    "env:development": "node ./src/config/scripts/set-environment.js development",
    "env:qa": "node ./src/config/scripts/set-environment.js qa",
    "aab": "cd android && ./gradlew bundleRelease",
    "reset": "react-native start --reset-cache",
    "stop": "lsof -ti:8081 | xargs kill -9 || true",
    "clean-all": "yarn stop && watchman watch-del-all && rm -rf node_modules && yarn install && cd android && ./gradlew clean && cd ..",
    "fresh-start": "yarn stop && watchman watch-del-all && yarn start --reset-cache",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native/new-app-screen": "0.80.0",
    "@react-navigation/bottom-tabs": "^6.x",
    "@react-navigation/native": "^6.x",
    "@react-navigation/native-stack": "^6.x",
    "@sentry/react-native": "^7.4.0",
    "add": "^2.0.6",
    "deprecated-react-native-prop-types": "^5.0.0",
    "hoist-non-react-statics": "^3.3.2",
    "i18n-js": "^3.8.0",
    "immutable": "^5.1.4",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "lodash.memoize": "^4.1.2",
    "lottie-react-native": "^7.3.4",
    "memoize-one": "^6.0.0",
    "moment": "^2.30.1",
    "react": "19.1.0",
    "react-native": "0.80.0",
    "react-native-audio-recorder-player": "3.6.10",
    "react-native-call-detection": "^1.9.0",
    "react-native-device-info": "^14.1.1",
    "react-native-exit-app": "^1.1.0",
    "react-native-fs": "^2.20.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-localize": "^2.1.6",
    "react-native-permissions": "^5.4.2",
    "react-native-reconnecting-websocket": "^2.0.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.18.0",
    "react-native-slider": "0.11.0",
    "react-native-svg": "^15.14.0",
    "react-native-svg-transformer": "^1.5.1",
    "react-native-swipe-gestures": "^1.0.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-webview": "^13.16.0",
    "react-redux": "^9.2.0",
    "recyclerlistview": "^4.2.3",
    "redux": "^4.1.2",
    "redux-logger": "^3.0.6",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.1",
    "rn-fetch-blob": "^0.12.0",
    "xdate": "^0.8.3",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.0",
    "@react-native/eslint-config": "0.80.0",
    "@react-native/metro-config": "0.80.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
